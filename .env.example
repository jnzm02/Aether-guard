# ─────────────────────────────────────────────────────────────────────────────
# Aether-Guard environment variables
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — Phase 3 AI Agent
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Priority 8 — RAG-Augmented Investigation (optional, enables similarity search)
VOYAGE_API_KEY=pa-...

# Priority 9 — Real-Traffic Validation Service (optional, enables event-tracker)
# Generate a classic GitHub PAT with NO scopes selected (public data only)
# Purpose: Raises rate limit from 60/hour to 5000/hour for public events API
GITHUB_TOKEN=ghp_...

# Optional overrides (defaults shown)
CLAUDE_MODEL=claude-sonnet-4-5-20250929
POLL_INTERVAL=10
CONFIDENCE_THRESHOLD=0.60

# Priority 8 — RAG Investigation Parameters
SIMILARITY_MIN_CONFIDENCE=0.7  # Min confidence for retrieving similar past incidents
RAG_ENABLED=true               # Enable multi-step RAG investigation graph
RAG_MAX_ITERATIONS=2           # Max refine cycles (hard iteration cap to prevent unbounded loops)
RAG_CONFIDENCE_THRESHOLD=0.75  # Min confidence to finalize without additional context gathering

# Set to "true" to analyze alerts without ACKing them (safe for testing)
DRY_RUN=false

# ─────────────────────────────────────────────────────────────────────────────
# Service Configuration — For using Aether-Guard with YOUR service
# ─────────────────────────────────────────────────────────────────────────────

# MONITORED_JOB: The "job" label value in your Prometheus scrape_configs
# This MUST match the job label your Prometheus assigns to your service.
# Example: If your prometheus.yml has:
#   scrape_configs:
#     - job_name: "my-api-service"
#       static_configs:
#         - targets: ["my-api:8080"]
# Then set: MONITORED_JOB=my-api-service
MONITORED_JOB=target-service

# TARGET_CONTAINER: Docker container name or Kubernetes pod name pattern
# This is used for:
#   - Fetching container logs for enrichment
#   - Docker SDK remediation actions (restart, scale, rollback)
#   - Container-level metric queries (memory, CPU)
# Must match your actual container/pod name
TARGET_CONTAINER=target-service
