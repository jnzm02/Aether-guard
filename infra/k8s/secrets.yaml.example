# ─────────────────────────────────────────────────────────────────────────────
# Aether-Guard — Kubernetes Secrets Template
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: This is a template. Create the actual secret using the script below.
#            NEVER commit secrets.yaml with real values to git!
# ─────────────────────────────────────────────────────────────────────────────
#
# After running `terraform apply`, create secrets with:
#
#   kubectl create secret generic aether-guard-secrets \
#     --namespace=aether-guard \
#     --from-literal=anthropic-api-key="YOUR_ANTHROPIC_API_KEY" \
#     --from-literal=postgres-url="$(terraform output -raw postgres_connection_string)"
#
# Or use this manifest (base64-encode values first):
#
# apiVersion: v1
# kind: Secret
# metadata:
#   name: aether-guard-secrets
#   namespace: aether-guard
# type: Opaque
# data:
#   anthropic-api-key: <base64-encoded-key>
#   postgres-url: <base64-encoded-connection-string>
# ─────────────────────────────────────────────────────────────────────────────
